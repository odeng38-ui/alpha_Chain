# PostgreSQL Settings
POSTGRES_USER=alphachain
POSTGRES_PASSWORD=alphachain_secret
POSTGRES_DB=alphachain_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://alphachain:alphachain_secret@localhost:5432/alphachain_db

# Redis Settings
REDIS_PORT=6379
